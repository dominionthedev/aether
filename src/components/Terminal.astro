<div id="terminal" class="hidden">
  <div id="output" aria-live="polite"></div>
  <div id="input-line">
    <span id="prompt"></span>
    <input
      id="cmdline"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="AETHER command line"
      autofocus
    />
    <span id="cursor" aria-hidden="true">█</span>
  </div>
</div>
